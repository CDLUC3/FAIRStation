#!/usr/bin/env ruby
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)
DATABASE_HOST = ENV.fetch("DATABASE_HOST", "127.0.0.1")
DATABASE_PORT = Integer(ENV.fetch("DATABASE_PORT", "3306"))

def system!(*args)
  system(*args, exception: true)
end

def database_ready?(retries: 1)
  retries.times do |attempt|
    TCPSocket.new(DATABASE_HOST, DATABASE_PORT).close
    return true
  rescue SystemCallError
    sleep 1 unless attempt == retries - 1
  end
  false
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Starting MySQL =="
  if database_ready?(retries: 30)
    puts "MySQL already accepting connections on #{DATABASE_HOST}:#{DATABASE_PORT}"
  else
    system! "docker compose up -d --wait db"
    abort "MySQL did not accept connections on #{DATABASE_HOST}:#{DATABASE_PORT}" unless database_ready?(retries: 30)
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
