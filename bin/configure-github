#!/usr/bin/env ruby
# Preview by default. Applying requires repository administrator permission.
require "json"
require "open3"
require "base64"
require "yaml"

REPOSITORY = "CDLUC3/FAIRStation"
API = "repos/#{REPOSITORY}"

unless ARGV.empty? || ARGV == [ "--apply" ]
  abort "Usage: bin/configure-github [--apply]"
end

def github(path, method: "GET", body: nil)
  command = [ "gh", "api", "--method", method, path ]
  command += [ "--input", "-" ] if body
  output, error, status = Open3.capture3(*command, stdin_data: body ? JSON.generate(body) : "")
  abort "GitHub #{method} #{path} failed: #{error}" unless status.success?
  output.empty? ? nil : JSON.parse(output)
end

rulesets = %w[development main].map do |branch|
  {
    name: "FAIR Station #{branch}", target: "branch", enforcement: "active",
    bypass_actors: [],
    conditions: { ref_name: { include: [ "refs/heads/#{branch}" ], exclude: [] } },
    rules: [
      { type: "deletion" },
      { type: "non_fast_forward" },
      {
        type: "pull_request",
        parameters: {
          allowed_merge_methods: branch == "main" ? [ "merge" ] : [ "merge", "squash" ],
          dismiss_stale_reviews_on_push: true,
          require_code_owner_review: false,
          require_last_push_approval: false,
          required_approving_review_count: 1,
          required_review_thread_resolution: true
        }
      },
      {
        type: "required_status_checks",
        parameters: {
          required_status_checks: %w[checks policy].map { |name| { context: name, integration_id: 15368 } },
          strict_required_status_checks_policy: false
        }
      }
    ]
  }
end
rulesets << {
  name: "FAIR Station release tags", target: "tag", enforcement: "active",
  bypass_actors: [],
  conditions: { ref_name: { include: [ "refs/tags/v*" ], exclude: [] } },
  rules: [ { type: "deletion" }, { type: "update" } ]
}
settings = {
  default_branch: "development", allow_merge_commit: true, allow_squash_merge: true,
  allow_rebase_merge: false, allow_auto_merge: false, delete_branch_on_merge: false,
  squash_merge_commit_title: "PR_TITLE", squash_merge_commit_message: "PR_BODY",
  merge_commit_title: "PR_TITLE", merge_commit_message: "PR_BODY"
}
environment = {
  deployment_branch_policy: { protected_branches: false, custom_branch_policies: true }
}
branch_policies = [ { name: "main", type: "branch" }, { name: "v*", type: "tag" } ]
repository_variables = %w[RELEASE_APP_ID].filter_map do |name|
  { name: name, value: ENV.fetch(name) } if ENV.key?(name)
end
environment_variables = %w[AWS_REGION AWS_RELEASE_ROLE_ARN AWS_PIPELINE_NAME].filter_map do |name|
  { name: name, value: ENV.fetch(name) } if ENV.key?(name)
end

unless ARGV == [ "--apply" ]
  puts JSON.pretty_generate({ repository: REPOSITORY, settings: settings, rulesets: rulesets,
    staging: environment, staging_ref_policies: branch_policies,
    repository_variables: repository_variables, staging_variables: environment_variables })
  exit
end

repository = github(API)
abort "Repository admin permission is required; no settings changed." unless repository.dig("permissions", "admin")
branches = github("#{API}/branches?per_page=100")
unless branches.any? { |branch| branch.fetch("name") == "development" }
  main = github("#{API}/git/ref/heads/main")
  github("#{API}/git/refs", method: "POST", body: { ref: "refs/heads/development", sha: main.dig("object", "sha") })
end
# Both protected branches must already contain the checks this script requires.
%w[development main].each do |branch|
  workflow = github("#{API}/contents/.github/workflows/ci.yml?ref=#{branch}")
  jobs = YAML.safe_load(Base64.decode64(workflow.fetch("content"))).fetch("jobs")
  abort "#{branch} must contain the checks and policy CI jobs before protection is enabled." unless %w[checks policy].all? { |name| jobs.key?(name) }
  github("#{API}/contents/.github/workflows/release-please.yml?ref=#{branch}")
end

github(API, method: "PATCH", body: settings)
existing_rules = github("#{API}/rulesets?includes_parents=false&per_page=100")
rulesets.each do |ruleset|
  existing = existing_rules.find { |rule| rule.fetch("name") == ruleset.fetch(:name) }
  path = "#{API}/rulesets"
  path += "/#{existing.fetch('id')}" if existing
  github(path, method: existing ? "PUT" : "POST", body: ruleset)
end

github("#{API}/environments/staging", method: "PUT", body: environment)
existing_policies = github("#{API}/environments/staging/deployment-branch-policies").fetch("branch_policies")
branch_policies.each do |policy|
  next if existing_policies.any? { |item| item["name"] == policy[:name] && item["type"] == policy[:type] }
  github("#{API}/environments/staging/deployment-branch-policies", method: "POST", body: policy)
end

{ "#{API}/actions/variables" => repository_variables,
  "#{API}/environments/staging/variables" => environment_variables }.each do |path, variables|
  next if variables.empty?
  existing = github("#{path}?per_page=100").fetch("variables").map { |variable| variable.fetch("name") }
  variables.each do |variable|
    present = existing.include?(variable.fetch(:name))
    github(present ? "#{path}/#{variable.fetch(:name)}" : path,
      method: present ? "PATCH" : "POST", body: variable)
  end
end
puts "Configured development default, protected branches, staging release refs, and supplied variables."
puts "Install the release GitHub App and set RELEASE_APP_PRIVATE_KEY separately; no secrets were read or written."
